# 本机单进程个人工作台；默认无需 Docker。
APP_STORAGE=local
WORKBENCH_DATA_DIR=work/local
# 可以在设置页填写；环境变量适合自动启动。不要提交真实密钥。
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_API_KEY=
AI_TIMEOUT_MS=60000
# 可选原有 Supabase 工作区：APP_STORAGE=supabase，填写原项目地址与 publishable key。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 首次使用原浏览器会话自动固定已有身份，或登录已有非匿名账号。
OWNER_EMAIL=
OWNER_PASSWORD=
# 仅旧管理脚本使用，不用于页面数据访问。
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
