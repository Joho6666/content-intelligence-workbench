# Browser-safe local Supabase values. supabase status prints the local values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:58321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Used only by local scripts and never sent to the browser.
SUPABASE_PROJECT_REF=phase-2-220px-sidebar-inbox-mock
SUPABASE_SERVICE_ROLE_KEY=

# Explicit pnpm db:seed demo account.
SEED_DEMO_EMAIL=demo@example.com
SEED_DEMO_PASSWORD=change-me-please
